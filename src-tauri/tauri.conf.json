{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kasumi",
  "version": "0.6.7",
  "identifier": "com.kip.kasumi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A notch-style taskbar, Start menu and status bar for Windows",
    "longDescription": "Kasumi: notches at the edges of the screen that open into a status bar, a dock with your apps, a launcher and pop-ups, in place of the Windows taskbar.",
    "copyright": "© 2026 Kip",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
