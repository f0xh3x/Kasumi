{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatusNotch",
  "version": "0.2.0",
  "identifier": "com.kip.statusnotch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A notch status bar for Windows",
    "longDescription": "StatusNotch: a black notch at the top of the screen that opens into a status bar.",
    "copyright": "© 2026 Kip",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
